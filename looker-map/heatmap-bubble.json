{
  "data": [
    {
      "id": "location",
      "label": "Location",
      "elements": [
        { "id": "lat",   "label": "Latitude",         "type": "DIMENSION", "options": { "min": 1, "max": 1 } },
        { "id": "lon",   "label": "Longitude",        "type": "DIMENSION", "options": { "min": 1, "max": 1 } },
        { "id": "label", "label": "Label (optional)", "type": "DIMENSION", "options": { "min": 0, "max": 1 } }
      ]
    },
    {
      "id": "metricSection",
      "label": "Size and colour metric",
      "elements": [
        { "id": "metric", "label": "Metric", "type": "METRIC", "options": { "min": 1, "max": 1 } }
      ]
    }
  ],
  "style": [
    {
      "id": "colors",
      "label": "Colour scale",
      "elements": [
        { "id": "minColor", "label": "Low",  "type": "FILL_COLOR", "defaultValue": "#FFFFFF" },
        { "id": "midColor", "label": "Mid",  "type": "FILL_COLOR", "defaultValue": "#0E7C8B" },
        { "id": "maxColor", "label": "High", "type": "FILL_COLOR", "defaultValue": "#C0392B" }
      ]
    },
    {
      "id": "bubbles",
      "label": "Bubbles",
      "elements": [
        { "id": "maxRadius",   "label": "Max radius (px)", "type": "TEXTINPUT", "defaultValue": "28" },
        { "id": "fillOpacity", "label": "Fill opacity",    "type": "OPACITY",   "defaultValue": "0.85" },
        { "id": "showLabels",  "label": "Show labels",     "type": "CHECKBOX",  "defaultValue": true }
      ]
    }
  ]
}
